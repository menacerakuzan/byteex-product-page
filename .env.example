# Sanity — defaults point at the public demo project, override to use your own.
NEXT_PUBLIC_SANITY_PROJECT_ID=8apnhmq3
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-09-01

# Secret shared with the Sanity webhook that calls /api/revalidate on publish.
SANITY_REVALIDATE_SECRET=

# Canonical site URL used for SEO metadata (falls back to the Vercel URL).
NEXT_PUBLIC_SITE_URL=
